          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('scheduleId', pm.response.json().datos.id_horario);"]}}]
        },
        {
          "name": "12 PUT Actualizar horario - 200",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"id_usuario\": {{userId}},\n  \"fecha\": \"2099-10-24\",\n  \"hora_inicio\": \"08:00\",\n  \"hora_fin\": \"17:00\",\n  \"observacion\": \"Horario actualizado\"\n}"}, "url": "{{baseUrl}}/api/horarios/{{scheduleId}}"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "13 DELETE Eliminar horario - 200",
          "request": {"method": "DELETE", "url": "{{baseUrl}}/api/horarios/{{scheduleId}}"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));"]}}]
        },
