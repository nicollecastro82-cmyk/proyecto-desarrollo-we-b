          "name": "16 POST Crear mesa - 201",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"numero_mesa\": {{mesaNumber}}\n}"}, "url": "{{baseUrl}}/mesas"},
          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const number = 100000 + Math.floor(Math.random() * 800000);", "pm.environment.set('mesaNumber', number);", "pm.environment.set('mesaUpdatedNumber', number + 1);"]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('mesaId', pm.response.json().id_mesa);"]}}
          ]
