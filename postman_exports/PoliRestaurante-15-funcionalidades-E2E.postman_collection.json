          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"nombre\": \"{{productName}}\",\n  \"descripcion\": \"Producto E2E\",\n  \"precio\": 25000,\n  \"id_categoria\": {{productCategoryId}}\n}"}, "url": "{{baseUrl}}/productos"},
          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.environment.set('productName', 'Producto E2E ' + Date.now());"]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('productId', pm.response.json().id_producto);"]}}
          ]
        },
