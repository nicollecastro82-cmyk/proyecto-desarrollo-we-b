          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const run = Date.now();", "pm.environment.set('clientLogin', 'cliente_e2e_' + run);", "pm.environment.set('clientEmail', 'cliente_e2e_' + run + '@example.com');"]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('clientId', pm.response.json().datos.id_usuario);"]}}
          ]
        },
        {
          "name": "09 POST Crear domiciliario - 201",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"id_tipo_usuario\": {{courierRoleId}},\n  \"nombre\": \"Domiciliario E2E\",\n  \"usuario_login\": \"{{courierLogin}}\",\n  \"contrasena\": \"ClaveSegura123\",\n  \"correo\": \"{{courierEmail}}\"\n}"}, "url": "{{baseUrl}}/api/usuarios"},
          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const run = Date.now();", "pm.environment.set('courierLogin', 'domiciliario_e2e_' + run);", "pm.environment.set('courierEmail', 'domiciliario_e2e_' + run + '@example.com');"]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('courierId', pm.response.json().datos.id_usuario);"]}}
          ]
        },
        {
          "name": "10 POST Iniciar sesión - 200",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"usuario_login\": \"{{employeeLogin}}\",\n  \"contrasena\": \"ClaveSegura123\"\n}"}, "url": "{{baseUrl}}/api/auth/login"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));"]}}]
        },
