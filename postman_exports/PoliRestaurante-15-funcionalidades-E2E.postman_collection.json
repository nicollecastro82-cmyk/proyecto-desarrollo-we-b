          "name": "15 PUT Actualizar producto - 200",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"descripcion\": \"Producto actualizado E2E\",\n  \"precio\": \"26000.50\"\n}"}, "url": "{{baseUrl}}/productos/{{productId}}"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));"]}}]
        },
