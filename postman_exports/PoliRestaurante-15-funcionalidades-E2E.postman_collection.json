          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const run = Date.now();", "pm.environment.set('employeeLogin', 'mesero_e2e_' + run);", "pm.environment.set('employeeEmail', 'mesero_e2e_' + run + '@example.com');"]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().datos.id_usuario);"]}}
          ]
        },
        {
