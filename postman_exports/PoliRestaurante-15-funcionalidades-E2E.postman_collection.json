          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"tipo\": \"SALON\",\n  \"id_mesa\": {{mesaId}},\n  \"id_mesero\": {{userId}},\n  \"observaciones\": \"Pedido E2E\"\n}"}, "url": "{{baseUrl}}/api/pedidos"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) { const p=pm.response.json().datos; pm.environment.set('salonOrderId', p.id_pedido); pm.environment.set('orderId', p.id_pedido); }"]}}]
        },
