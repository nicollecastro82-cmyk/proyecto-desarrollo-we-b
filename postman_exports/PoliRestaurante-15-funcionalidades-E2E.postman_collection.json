{
  "info": {
    "_postman_id": "e5e34d98-720a-46c0-b5cb-cc26220c8e01",
    "name": "PoliRestaurante - 15 funcionalidades E2E",
    "description": "Colección ejecutable de principio a fin. Crea datos temporales identificables, demuestra las 15 funcionalidades en el orden correcto y termina con desactivación lógica de los datos administrativos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación y CRUD administrativos",
      "item": [
        {
          "name": "01 GET Salud - 200",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/salud"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));", "pm.test('PostgreSQL conectado', () => pm.expect(pm.response.json().base_datos).to.eql('conectada'));"]}}]
        },
        {
          "name": "02 POST Crear categoría temporal - 201",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"nombre\": \"{{categoryName}}\",\n  \"activo\": true\n}"}, "url": "{{baseUrl}}/api/categorias"},
          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.environment.set('categoryName', 'Categoria E2E ' + Date.now());"]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('categoryId', pm.response.json().datos.id_categoria);"]}}
          ]
        },
        {
          "name": "03 PUT Actualizar categoría - 200",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"nombre\": \"{{categoryName}} actualizada\",\n  \"activo\": true\n}"}, "url": "{{baseUrl}}/api/categorias/{{categoryId}}"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "04 GET Elegir categoría existente para Producto - 200",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/categorias"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));", "const own = Number(pm.environment.get('categoryId'));", "const categories = pm.response.json().datos;", "const selected = categories.find(c => c.activo && c.id_categoria !== own);", "pm.test('Existe otra categoría activa', () => pm.expect(selected).to.exist);", "if (selected) pm.environment.set('productCategoryId', selected.id_categoria);"]}}]
        },
        {
          "name": "05 GET Roles y guardar IDs - 200",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/tipos-usuario"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Estado 200', () => pm.response.to.have.status(200));", "const roles = pm.response.json().datos;", "const mapping = {MESERO:'employeeRoleId', COCINA:'kitchenRoleId', CLIENTE:'clientRoleId', DOMICILIARIO:'courierRoleId'};", "Object.entries(mapping).forEach(([role,key]) => { const found = roles.find(r => r.descripcion === role); if (found) pm.environment.set(key, found.id_tipo_usuario); });", "pm.test('Cuatro roles disponibles', () => Object.values(mapping).forEach(key => pm.expect(pm.environment.get(key), key).to.not.be.empty));"]}}]
        },
        {
          "name": "06 POST Crear mesero - 201",
